{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "centershop/shop-list",
  "title": "Butiksliste",
  "category": "widgets",
  "icon": "store",
  "description": "Viser butikker filtreret efter status og kategori",
  "attributes": {
    "availability": {
      "type": "string",
      "default": "all"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "textdomain": "centershop_txtdomain",
  "editorScript": "centershop-shop-list-editor",
  "style": "centershop-shop-list-style"
}
