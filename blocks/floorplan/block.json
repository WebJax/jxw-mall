{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "centershop/floorplan",
    "title": "Center Grundplan",
    "category": "widgets",
    "icon": "location-alt",
    "description": "Vis interaktiv grundplan over centret med butikslokaler",
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    },
    "attributes": {
        "focus": {
            "type": "string",
            "default": ""
        },
        "showSearch": {
            "type": "boolean",
            "default": true
        },
        "height": {
            "type": "number",
            "default": 560
        },
        "focusZoom": {
            "type": "number",
            "default": 150
        }
    },
    "textdomain": "centershop_txtdomain",
    "editorScript": "centershop-floorplan-editor",
    "script": "centershop-floorplan",
    "style": "centershop-floorplan"
}
